{
  "name": "mfm-js",
  "version": "0.26.0",
  "description": "An MFM parser implementation with TypeScript",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "main": "./built/index.mjs",
  "types": "./built/index.d.ts",
  "exports": {
    ".": {
      "import": "./built/index.mjs",
      "require": "./built/index.cjs",
      "types": "./built/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "tsc": "tsc --noEmit",
    "tsd": "tsd",
    "parse": "node ./built/cli/parse.cjs",
    "parse-simple": "node ./built/cli/parseSimple.cjs",
    "api": "pnpm exec api-extractor run --local --verbose",
    "api-prod": "pnpm exec api-extractor run --verbose",
    "lint": "oxlint",
    "vitest": "vitest run --coverage",
    "test": "pnpm run vitest && pnpm run tsd"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misskey-dev/mfm.js.git"
  },
  "author": "Marihachi",
  "license": "MIT",
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.4",
    "@misskey-dev/oxlint-fmt-config": "^0.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsd": "0.33.0",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@misskey-dev/emoji-data": "17.0.3"
  },
  "files": [
    "built",
    "CHANGELOG.md"
  ]
}
