{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./built",
    "removeComments": true,
    "strict": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "types": ["node"],
  },
  "typeRoots": [
    "node_modules/@types",
    "src/@types",
  ],
  "include": [
    "src/**/*",
  ],
  "exclude": [
    "node_modules",
    "test/**/*",
    "test-d/**/*",
  ]
}
